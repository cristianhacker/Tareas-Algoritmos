Algoritmo ejercicio04
	Definir tarea1, tarea2, tarea3, promedio Como Real
	Escribir 'Ingrese su nota: '
	Leer tarea1
	Escribir 'Ingrese su nota: '
	Leer tarea2
	Escribir 'Ingrese su nota: '
	Leer tarea3
	promedio <- (tarea1+tarea2+tarea3)/3
	Si promedio>13 Entonces
		Escribir 'Aprobado'
	SiNo
		Escribir 'Desaprobado'
	FinSi
FinAlgoritmo
