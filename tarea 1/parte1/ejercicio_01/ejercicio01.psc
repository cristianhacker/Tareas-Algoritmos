Algoritmo operaciones
	Definir num1, num2, suma, resta, producto, division, resto Como Real
	Escribir 'Ingrese un número: '
	Leer num1
	Escribir 'Ingrese un número: '
	Leer num2
	suma <- num1+num2
	resta <- num1-num2
	producto <- num1*num2
	division <- num1/num2
	resto <- num1 MOD num2
	Escribir 'El resultado de la suma es: ', suma
	Escribir 'El resultado de la resta es: ', resta
	Escribir 'El resultado del producto es: ', producto
	Escribir 'El rsultado de la división es: ', division
	Escribir 'El resultado del resto entero es:', resto
FinAlgoritmo
